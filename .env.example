# Copy this file to .env and fill in the values. Never commit .env.

# Set to "production" on the live server (turns on secure cookies and HSTS; needs HTTPS).
APP_ENV=development

# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# If left empty, one is created and saved in instance/secret_key.
SECRET_KEY=

# Address and port for `python run.py`
HOST=127.0.0.1
PORT=8000

# Set to 1 when running behind Nginx, Cloudflare or a hosting proxy, so visitor IPs are correct.
TRUST_PROXY=

# Email for enquiry alerts and visitor confirmations. Without these, emails are only logged.
# Use a sending service (Brevo, Mailgun, Amazon SES) or a Gmail app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=KF 4Fortken <no-reply@example.com>
